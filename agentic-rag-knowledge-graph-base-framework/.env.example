# Core configuration
RUNTIME__ENVIRONMENT=development
PROJECT_NAME=Agentic RAG Base Framework

# Database / Vector store
DATABASE__URL=postgresql://postgres:postgres@localhost:5432/postgres
VECTOR_STORE__COLLECTION_NAME=documents
VECTOR_STORE__EMBEDDING_DIMENSION=1536

# Knowledge graph
KNOWLEDGE_GRAPH__ENABLED=true
GRAPH_STORE__URI=bolt://localhost:7687
GRAPH_STORE__USER=neo4j
GRAPH_STORE__PASSWORD=neo4j

# LLM provider
LLM__PROVIDER=openai
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=changeme
LLM__MODEL=gpt-4.1-mini

# Embeddings
EMBEDDINGS__PROVIDER=openai
EMBEDDINGS__MODEL=text-embedding-3-small

# API
API__HOST=0.0.0.0
API__PORT=8058
